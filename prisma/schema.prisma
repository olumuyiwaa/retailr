// Retailr: PostgreSQL schema, derived from src/types/saas.ts and the mock services in src/services (frontend repo).
// Conventions
//  - ids are cuid strings; every tenant-owned table carries businessId and is always queried with it.
//  - money is Decimal(12,2). Business-side amounts are in that business's currency; plan and
//    subscription amounts are USD (the platform's accounting currency).
//  - timestamps are timestamptz (Prisma DateTime on Postgres).

generator client {
  provider   = "prisma-client-js"
  engineType = "client" // query compiler + driver adapter (@prisma/adapter-pg); no native engine binary
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum Role {
  SUPER_ADMIN
  BUSINESS_ADMIN
}

enum BusinessStatus {
  ACTIVE
  TRIAL
  PENDING
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum Currency {
  NGN
  GHS
  KES
  USD
}

enum InvoiceStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ServiceStatus {
  ACTIVE
  DRAFT
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PAID
  UNPAID
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK
  CARD
  CASH
  POS
}

enum SalesChannel {
  ONLINE
  IN_STORE
  WHATSAPP
  INSTAGRAM
  PHONE
  OTHER
}

enum DiscountType {
  PERCENT
  FIXED
}

enum DiscountStatus {
  ACTIVE
  DISABLED
}

enum GroupKind {
  MANUAL
  AUTO
}

enum GroupRuleType {
  SPENT_OVER
  ORDERS_AT_LEAST
  JOINED_WITHIN_DAYS
  NO_ORDER_WITHIN_DAYS
}

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum TeamRole {
  OWNER
  MANAGER
  STAFF
}

enum TeamStatus {
  ACTIVE
  INVITED
}

// ---------- identity ----------

model User {
  id                String             @id @default(cuid())
  email             String             @unique // stored lower-case
  name              String
  passwordHash      String
  role              Role
  /// Set for BUSINESS_ADMIN. One login belongs to one business for now (see README, "Later").
  businessId        String?
  business          Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Set once the person has proved they own the address (verification link, reset link or accepted invite).
  emailVerifiedAt   DateTime?
  teamMember        TeamMember?
  authTokens        AuthToken[]
  calendarFeeds     CalendarFeed[]
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([businessId])
}

enum AuthTokenKind {
  PASSWORD_RESET
  EMAIL_VERIFY
}

/// Single-use links sent by email. Only the hash is stored, so a database leak can't be used to reset anyone's password.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- platform: plans, subscriptions, invoices, platform discounts ----------

model Plan {
  id                String   @id // stable keys such as "plan_growth", referenced by the frontend
  name              String
  description       String   @default("")
  priceMonthly      Decimal  @db.Decimal(12, 2) // USD
  priceYearly       Decimal  @db.Decimal(12, 2) // USD
  transactionFeePct Decimal  @default(0) @db.Decimal(5, 2)
  /// -1 = unlimited
  maxProducts       Int
  maxStaff          Int
  maxOrdersPerMonth Int
  maxStorageGb      Int
  /// -1 = unlimited. Monthly SMS campaign credits for the business.
  maxSmsPerMonth    Int      @default(50)
  features          String[]
  /// Storefront theme ids this plan may use ("classic" is always allowed). Set by the platform admin.
  themes            String[] @default(["classic", "showcase", "atelier", "market", "shop"])
  highlighted       Boolean  @default(false)
  isActive          Boolean  @default(true)
  /// { "NGN": { "monthly": 9000, "yearly": 90000 }, ... } hand-set local prices
  localPrices       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  businesses    Business[]
  subscriptions Subscription[]
  invoices      Invoice[]
  couponPlans   PlanCouponPlan[]
}

model Business {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique // storefront lives at /s/<slug>
  category           String // business type, e.g. "Fashion & Textiles"
  ownerName          String
  ownerEmail         String
  phone              String         @default("")
  country            String
  city               String
  brandColor         String         @default("#465fff")
  theme              String? // storefront theme id, null = default
  logoUrl            String?
  currency           Currency       @default(NGN)
  /// How shoppers may pay at checkout, chosen by the owner: any of "cod", "bank", "card"
  paymentMethods     String[]       @default(["cod", "bank", "card"])
  /// Shown to shoppers who choose bank transfer (account name, number, bank)
  bankDetails        String         @default("")
  description        String         @default("")
  status             BusinessStatus @default(PENDING)
  /// Why a SUSPENDED business was suspended: "ADMIN" (the platform did it) or "NON_PAYMENT" (billing did; paying lifts it).
  suspensionReason   String?
  planId             String
  plan               Plan           @relation(fields: [planId], references: [id])
  /// IANA zone the business's opening hours are in, e.g. "Africa/Lagos".
  timezone           String         @default("Africa/Lagos")
  /// { mon: [{ start: "09:00", end: "17:00" }], ... }; null = Monday to Friday 09:00-17:00.
  bookingHours       Json?
  /// Shortest notice a customer can book with, in hours.
  bookingNoticeHours Int            @default(2)
  /// true = bookings are confirmed straight away; false = the team confirms each one.
  bookingAutoConfirm Boolean        @default(true)
  /// Last used order number for "#AD1180"-style numbering; increment atomically inside the order transaction.
  orderSeq           Int            @default(999)
  createdAt          DateTime       @default(now()) // "joinedAt" in the API
  updatedAt          DateTime       @updatedAt

  users         User[]
  team          TeamMember[]
  subscription  Subscription?
  invoices      Invoice[]
  categories    Category[]
  products      Product[]
  services      Service[]
  customers     Customer[]
  orders        Order[]
  bookings      Booking[]
  calendarFeeds CalendarFeed[]
  coupons       Coupon[]
  groups        CustomerGroup[]
  messages      Message[]
  expenses      Expense[]
  planCoupons   PlanCoupon[]
  redemptions   PlanCouponRedemption[]

  @@index([status])
  @@index([planId])
}

model TeamMember {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId          String?    @unique // set once the invite is accepted
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  email           String
  role            TeamRole
  status          TeamStatus @default(INVITED)
  inviteTokenHash String?    @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime   @default(now())

  @@unique([businessId, email])
}

model Subscription {
  id                     String             @id @default(cuid())
  businessId             String             @unique
  business               Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus
  cycle                  BillingCycle
  /// What the business pays each period in USD, already net of any platform discount.
  amount                 Decimal            @db.Decimal(12, 2)
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  cancelledAt            DateTime?
  /// Platform discount in use, and what it takes off each period (USD).
  planCouponId           String?
  planCoupon             PlanCoupon?        @relation(fields: [planCouponId], references: [id], onDelete: SetNull)
  discount               Decimal?           @db.Decimal(12, 2)
  /// Payment-provider references (Paystack / Flutterwave / Stripe)
  providerCustomerId     String?
  providerSubscriptionId String?
  /// Reusable card token from the provider, used to renew without the customer being present.
  providerAuthorization  String?
  /// Which provider the card token belongs to ("paystack", "flutterwave"); renewals are charged through it.
  provider               String?
  trialReminderSentAt    DateTime?
  createdAt              DateTime           @default(now()) // "startedAt" in the API
  updatedAt              DateTime           @updatedAt

  @@index([status])
}

model Invoice {
  id                String        @id @default(cuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId            String
  plan              Plan          @relation(fields: [planId], references: [id])
  description       String
  amount            Decimal       @db.Decimal(12, 2) // USD
  status            InvoiceStatus
  /// Unique per payment attempt: what the provider calls the transaction. Makes webhooks and retries idempotent.
  providerReference String?       @unique
  /// Which provider this payment went through.
  provider          String?
  /// "CHECKOUT" (the business paid to start or change a plan) or "RENEWAL" (charged automatically at period end).
  kind              String        @default("CHECKOUT")
  attempt           Int           @default(1)
  /// What the payment buys: applied to the subscription when it succeeds.
  cycle             BillingCycle?
  planCouponId      String?
  discount          Decimal?      @db.Decimal(12, 2)
  /// What was actually charged, in the business's currency (amount above is the USD accounting value).
  chargeAmount      Decimal?      @db.Decimal(12, 2)
  chargeCurrency    String?
  issuedAt          DateTime      @default(now())
  paidAt            DateTime?

  @@index([businessId, issuedAt])
  @@index([status])
}

/// A discount the platform gives businesses on their Retailr subscription (amounts in USD).
model PlanCoupon {
  id         String         @id @default(cuid())
  code       String         @unique // upper-case
  type       DiscountType
  value      Decimal        @db.Decimal(12, 2) // percent 1-100, or USD off each period
  /// Only this business may use it. Null = anyone.
  businessId String?
  business   Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  maxUses    Int?
  expiresAt  DateTime?
  status     DiscountStatus @default(ACTIVE)
  note       String?
  createdAt  DateTime       @default(now())

  /// Empty = every paid plan.
  plans         PlanCouponPlan[]
  redemptions   PlanCouponRedemption[]
  subscriptions Subscription[]
}

model PlanCouponPlan {
  planCouponId String
  planCoupon   PlanCoupon @relation(fields: [planCouponId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planCouponId, planId])
}

/// One row per business per code, so changing billing cycle never uses a second redemption.
/// usedCount in the API = count of these rows.
model PlanCouponRedemption {
  id           String     @id @default(cuid())
  planCouponId String
  planCoupon   PlanCoupon @relation(fields: [planCouponId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([planCouponId, businessId])
}

// ---------- catalogue ----------

model Category {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  imageUrl   String?
  createdAt  DateTime  @default(now())
  products   Product[]
  services   Service[]

  /// Names are unique per business, case-insensitively: enforce with a unique index on (businessId, lower(name)) in the first migration's raw SQL.
  @@unique([businessId, name])
}

model Product {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Deleting a category leaves its products uncategorised.
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  sku         String        @default("")
  description String        @default("")
  price       Decimal       @db.Decimal(12, 2)
  /// With variants this is kept equal to the sum of the variants' stock.
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  sold        Int           @default(0)
  imageColor  String        @default("#c3ceff") // placeholder tile when there is no photo
  /// [{ "label": "Material", "value": "Cotton" }], at most 10
  specs       Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([businessId, status])
  @@index([businessId, categoryId])
}

/// Something customers book or buy by the job: no stock, never sold out. Kept apart from Product so each can grow on its own terms.
model Service {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name          String
  description   String        @default("")
  /// Base price; an option's own price overrides it.
  price         Decimal       @db.Decimal(12, 2)
  /// How long it takes, in minutes (shown to shoppers; required to be bookable).
  durationMins  Int?
  /// Customers pick a time slot instead of adding it to a cart. Needs durationMins.
  bookable      Boolean       @default(false)
  /// How many bookings may overlap (staff or chairs).
  maxConcurrent Int           @default(1)
  status        ServiceStatus @default(ACTIVE)
  sold          Int           @default(0)
  imageColor    String        @default("#c3ceff")
  /// [{ "label": "Includes", "value": "Wash and style" }], at most 10
  specs         Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  images     ServiceImage[]
  options    ServiceOption[]
  orderItems OrderItem[]
  bookings   Booking[]

  @@index([businessId, status])
  @@index([businessId, categoryId])
}

model ServiceImage {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url       String
  position  Int // 0 = cover; at most 6 per service

  @@unique([serviceId, position])
}

/// A priced choice such as "Short hair" or "Long hair".
model ServiceOption {
  id         String      @id @default(cuid())
  serviceId  String
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name       String
  /// Overrides the service price when set.
  price      Decimal?    @db.Decimal(12, 2)
  position   Int         @default(0)
  orderItems OrderItem[]

  @@unique([serviceId, name])
}

/// A time slot a customer reserved for a bookable service. Name and price are copied so history survives edits and deletes.
model Booking {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceName   String
  variantName   String?
  price         Decimal       @db.Decimal(12, 2)
  startsAt      DateTime
  endsAt        DateTime
  status        BookingStatus @default(CONFIRMED)
  customerName  String
  customerEmail String?
  customerPhone String?
  notes         String?
  /// "store" (customer booked online) or "admin" (the team booked it)
  source        String        @default("store")
  publicToken   String        @unique @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([businessId, startsAt])
  @@index([serviceId, startsAt])
}

/// A private link (iCalendar) that Google, Apple or Outlook calendar can subscribe to. The link is the credential, so only its hash is stored.
model CalendarFeed {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Who made it. The link stops working when this person leaves the team.
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String?
  tokenHash      String    @unique
  lastAccessedAt DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([businessId, userId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // object-storage URL, never a data URL
  position  Int // 0 = cover; at most 6 per product

  @@unique([productId, position])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // "Large / Red"
  /// Overrides the product price when set.
  price      Decimal?    @db.Decimal(12, 2)
  stock      Int         @default(0)
  position   Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, name])
}

// ---------- customers ----------

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  /// Checkout matches or creates the customer by lower-cased email. Null for walk-ins.
  email       String?
  phone       String   @default("")
  city        String   @default("")
  /// Denormalised; recompute from paid orders whenever an order's payment or status changes.
  ordersCount Int      @default(0)
  totalSpent  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  orders       Order[]
  bookings     Booking[]
  groupMembers CustomerGroupMember[]

  @@unique([businessId, email])
  @@index([businessId, createdAt])
}

model CustomerGroup {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  kind        GroupKind
  /// AUTO groups only: members are computed from the rule, never stored.
  ruleType    GroupRuleType?
  ruleValue   Decimal?       @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())

  members CustomerGroupMember[] // MANUAL groups only

  @@unique([businessId, name])
}

model CustomerGroupMember {
  groupId    String
  group      CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([groupId, customerId])
}

// ---------- orders ----------

model Order {
  id              String         @id @default(cuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// "#AD1180": two letters of the slug plus Business.orderSeq. Unique per business.
  number          String
  /// Null for walk-in sales recorded without a customer.
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Snapshot of what the shopper typed at checkout.
  customerName    String
  customerEmail   String?
  customerPhone   String?
  shippingAddress String?
  notes           String?
  channel         SalesChannel   @default(ONLINE)
  paymentMethod   PaymentMethod?
  status          OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(UNPAID)
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  /// subtotal - discount
  total           Decimal        @db.Decimal(12, 2)
  couponCode      String?
  receiptSentAt   DateTime?
  /// Unguessable token for the public confirmation/invoice link (the mock uses the order id, which is guessable).
  publicToken     String         @unique @default(cuid())
  placedAt        DateTime       @default(now())

  items OrderItem[]

  @@unique([businessId, number])
  @@index([businessId, placedAt])
  @@index([businessId, status])
  @@index([customerId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Exactly one of product / service is set. Nullable so deleting either keeps order history intact.
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  serviceId String?
  service   Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  optionId  String?
  option    ServiceOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)
  /// Snapshots: "Silk Wrap Dress (Large)" and the unit price at the time of sale.
  name      String
  qty       Int
  price     Decimal         @db.Decimal(12, 2)
}

/// Shopper discount codes a business creates for its own storefront.
model Coupon {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code       String // upper-case
  type       DiscountType
  value      Decimal        @db.Decimal(12, 2) // percent 1-100, or amount off in the business currency
  minOrder   Decimal?       @db.Decimal(12, 2)
  maxUses    Int?
  usedCount  Int            @default(0)
  expiresAt  DateTime?
  status     DiscountStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())

  @@unique([businessId, code])
}

// ---------- messaging ----------

model Message {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel        MessageChannel
  subject        String? // email only
  /// Template; {{first_name}} and {{store}} are filled in per customer.
  body           String
  audienceLabel  String
  recipientCount Int
  /// How many were handed to the mail/SMS provider, and how many it refused or couldn't be sent to.
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  sentAt         DateTime       @default(now())
  jobs           MessageJob[]

  @@index([businessId, sentAt])
}

enum MessageJobStatus {
  PENDING
  SENT
  FAILED
}

/// One outbound email/SMS to deliver. Processed by JobsService so sends survive restarts and scale past in-process workers.
model MessageJob {
  id            String           @id @default(cuid())
  messageId     String
  message       Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  businessId    String
  channel       MessageChannel
  /// Email address or normalised phone digits.
  toAddress     String
  recipientName String           @default("")
  subject       String?
  /// Body with {{first_name}} / {{store}} already filled in.
  body          String
  status        MessageJobStatus @default(PENDING)
  attempts      Int              @default(0)
  lastError     String?
  createdAt     DateTime         @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([messageId])
  @@index([businessId, channel, status])
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  MARKETING
  SALARIES
  TRANSPORT
  OTHER
}

model Expense {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount     Decimal         @db.Decimal(12, 2)
  category   ExpenseCategory
  note       String          @default("")
  spentAt    DateTime
  createdAt  DateTime        @default(now())

  @@index([businessId, spentAt])
}

// ---------- analytics ----------

/// Daily roll-up. scope = a businessId for a storefront, or "platform" for the marketing site.
/// Written by POST /track (batched or via a queue); read by the analytics endpoints.
model AnalyticsDay {
  id               String   @id @default(cuid())
  scope            String
  date             DateTime @db.Date
  visitors         Int      @default(0) // unique per day
  sessions         Int      @default(0) // visits
  pageViews        Int      @default(0)
  productViews     Int      @default(0)
  addToCart        Int      @default(0)
  checkouts        Int      @default(0)
  /// Distinct sessions that reached each funnel step (the three counters above count events)
  productSessions  Int      @default(0)
  cartSessions     Int      @default(0)
  checkoutSessions Int      @default(0)
  /// Sessions that placed an online order (the storefront sends an "order" event once the order goes through)
  orderSessions    Int      @default(0)
  /// { "whatsapp": 12, "direct": 40, ... } and the same shape for the rest
  sources          Json     @default("{}")
  devices          Json     @default("{}")
  countries        Json     @default("{}")
  pages            Json     @default("{}")
  products         Json     @default("{}") // productId -> views

  @@unique([scope, date])
}

/// Dedupe markers for POST /track: one row per visitor (kind "v"), session (kind "s") or session-at-funnel-step (kinds "p", "c", "k", "o") per scope per day, keyed by a
/// hash so raw ids are never stored. Only needed for today, so rows older than two days are pruned.
model AnalyticsSeen {
  scope   String
  date    DateTime @db.Date
  kind    String
  keyHash String

  @@id([scope, date, kind, keyHash])
}

/// Who did what, when. Written for platform actions and sensitive business actions; never holds request bodies, passwords or tokens.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  /// The business it concerns (null for platform-wide actions with no single business).
  businessId String?
  actorId    String?
  actorRole  String
  /// "system" for jobs and webhooks.
  actorEmail String?
  action     String
  targetId   String?
  meta       Json?

  @@index([businessId, at])
  @@index([at])
}

// ---------- notifications ----------

enum NotificationType {
  NEW_ORDER
  LOW_STOCK
  OUT_OF_STOCK
  NEW_BUSINESS
  NEW_BOOKING
  BOOKING_CANCELLED
}

/// One row per person it is for, so each person has their own read state. Business admins get their business's; super admins get the platform's.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  type       NotificationType
  title      String
  body       String           @default("")
  /// An app path to open, e.g. "/admin/business/orders"
  link       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// A browser that agreed to receive push notifications (Web Push). One person can have several.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Platform-wide switches the super admin changes from the UI (not secrets: API keys stay in the environment).
/// key "payments": { "enabled": ["paystack", "flutterwave"], "default": "paystack" }
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
