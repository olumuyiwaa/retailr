NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retailr
# long random strings; generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# used by `npm run seed`
SEED_SUPER_ADMIN_EMAIL=admin@retailr.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- image uploads ---
# "local" stores files under LOCAL_UPLOAD_DIR and serves them at <API_PUBLIC_URL>/files (development only)
STORAGE_DRIVER=local
API_PUBLIC_URL=http://localhost:4000
LOCAL_UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=2097152
# "s3" works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO:
# STORAGE_DRIVER=s3
# S3_BUCKET=retailr-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# STORAGE_PUBLIC_URL=https://media.retailr.com

# no payment provider is connected yet: "true" makes card orders count as paid immediately (demo only)
DEMO_CARD_PAYMENTS=true

# email: "log" only logs; "smtp" sends through SMTP_URL (e.g. smtps://user:pass@smtp.example.com:465)
MAIL_DRIVER=log
# SMTP_URL=
MAIL_FROM="Retailr <noreply@retailr.com>"
# where the web app lives (links in emails)
APP_PUBLIC_URL=http://localhost:3000

# subscription payments: none (plan changes apply with no charge) | paystack
PAYMENTS_DRIVER=none
# PAYMENTS_DRIVER can list several, first is the default: paystack,flutterwave
# PAYSTACK_SECRET_KEY=sk_live_...
# FLUTTERWAVE_SECRET_KEY=FLWSECK-...
# FLUTTERWAVE_SECRET_HASH=a-long-random-string-also-set-in-the-flutterwave-dashboard
# background jobs on this instance (renewals, trial expiry, cleanup)
JOBS_ENABLED=true
DUNNING_GRACE_DAYS=7

# number of reverse proxies / load balancers in front of the API (so rate limits and analytics see real client IPs); 0 = none
TRUST_PROXY=0

# text messages: "log" only logs them; "termii" sends through Termii (needs TERMII_API_KEY)
SMS_DRIVER=log
# TERMII_API_KEY=
# the sender name on texts (register it with Termii first; unregistered names are rejected in Nigeria)
SMS_SENDER=Retailr
# generic (cheaper, blocked on do-not-disturb numbers) or dnd (reaches every number)
# TERMII_CHANNEL=dnd
