NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retailr
# long random strings; generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# used by `npm run seed`
SEED_SUPER_ADMIN_EMAIL=admin@retailr.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- image uploads ---
# "local" stores files under LOCAL_UPLOAD_DIR and serves them at <API_PUBLIC_URL>/files (development only)
STORAGE_DRIVER=local
API_PUBLIC_URL=http://localhost:4000
LOCAL_UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=2097152
# "s3" works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO:
# STORAGE_DRIVER=s3
# S3_BUCKET=retailr-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# STORAGE_PUBLIC_URL=https://media.retailr.com
